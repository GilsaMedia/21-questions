rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email.lower();
    }
    // The owner (same as ownerEmail in public/config.js) can manage the list of admins.
    function isOwner() {
      return signedIn() && email() == 'gilsalinas639@gmail.com';
    }
    function isAdmin() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(email())));
    }

    // One doc per extra admin, keyed by lowercase email. Admins can check their own entry.
    match /admins/{adminEmail} {
      allow get: if isOwner() || (signedIn() && email() == adminEmail);
      allow list, write: if isOwner();
    }

    // Quiz metadata (number, title, publish time) is public so the app can show the schedule.
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();

      // Questions and answers stay locked on the server until the publish time.
      match /questions/{questionId} {
        allow read: if isAdmin()
          || get(/databases/$(database)/documents/quizzes/$(quizId)).data.publishAt <= request.time;
        allow write: if isAdmin();
      }
    }

    // Anyone can register their device for notifications, nobody can read the list
    // (the notification job uses the Admin SDK, which bypasses these rules).
    match /pushRegs/{fid} {
      allow create, update: if request.resource.data.keys().hasOnly(['updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if true;
      allow read: if false;
    }
  }
}
